APP_PORT=8080
# Use 0.0.0.0 se um container separado precisar acessar a API por host.docker.internal.
APP_BIND_ADDRESS=127.0.0.1
POSTGRES_DB=backend_lab
POSTGRES_USER=backend_lab
POSTGRES_PASSWORD=backend_lab
JPA_DDL_AUTO=update
JWT_SECRET=change-this-secret-with-at-least-32-characters
JWT_EXPIRATION_SECONDS=3600
# Identifica quem emite o token interno.
JWT_ISSUER=tcc-backend-lab
# Identifica o destino previsto do token interno.
JWT_AUDIENCE=tcc-backend-lab-internal
# Tolerância entre relógios dos serviços, em segundos.
JWT_CLOCK_SKEW_SECONDS=30

#cria usuários iniciais na primeira execução.
AUTH_SEED_ADMIN_NAME=teste
AUTH_SEED_ADMIN_EMAIL=teste@teste.com
AUTH_SEED_ADMIN_PASSWORD=teste
AUTH_SEED_TECHNICIAN_NAME=
AUTH_SEED_TECHNICIAN_EMAIL=
AUTH_SEED_TECHNICIAN_PASSWORD=
