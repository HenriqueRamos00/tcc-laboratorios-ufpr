# Public defaults for the local AutoLAB demo. backend-portal-web/.env overrides these.
AutoLab__Server=sqlserver
AutoLab__Database=autolab
AutoLab__User=sa
AutoLab__Password=${SQLSERVER_SA_PASSWORD:-LactecDemo2026!}
AutoLab__Encrypt=false
AutoLab__TrustServerCertificate=true
AutoLab__ReadOnlyIntent=false
