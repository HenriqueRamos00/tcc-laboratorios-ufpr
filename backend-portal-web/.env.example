PORT=5125
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
Portal__DataSource=backend-lab # ou lactec (Backend Auth)
Portal__UseDemoData=false

# Endereço do Spring para o Compose isolado.
# Para dotnet run fora do Docker, use BackendLab__BaseUrl=http://localhost:8080.
BackendLab__BaseUrl=http://host.docker.internal:8080

Salesforce__Url=https://login.salesforce.com
Salesforce__TokenPath=/services/oauth2/token
Salesforce__ApiVersion=v60.0
Salesforce__GrantType=client_credentials
Salesforce__ClientId=your-connected-app-client-id
Salesforce__ClientSecret=your-connected-app-client-secret

# Obrigatórios somente em lactec; dotnet run lê variáveis do processo, não o .env.
# A demonstração completa usa ../compose.auth.yaml com padrões locais, sem este arquivo.
BackendAuth__BaseUrl=http://localhost:8081
BackendAuth__ServiceCode=portal-web
BackendAuth__ServiceToken=
PortalJwt__Issuer=portal-api
PortalJwt__Audience=portal-web
# Gere um segredo exclusivo: openssl rand -base64 32
PortalJwt__SigningKey=
PortalJwt__ExpirationSeconds=900

# Fontes do AutoLAB para o modo lactec. O compose.yaml da raiz as desliga explicitamente.
# Para o modo backend-lab isolado, configure as quatro fontes como not-connected.
# As quatro fontes aceitam sql-server e not-connected. LabResults__Scope: all mostra todos os
# registros; company filtra pela empresa da claim inquilino ou de LabResults__DevelopmentTenant.
LabResults__Source=sql-server
LabResults__Scope=all
EquipmentRegistry__Source=sql-server
LaboratoryProgress__Source=sql-server
ReportDocuments__Source=sql-server

# Banco local do AutoLAB (../compose.auth.yaml, serviço sqlserver com a massa de autolab-init).
# Para o AutoLAB real: AutoLab__Server=LACTECSQL10,49933, AutoLab__Database=bdautolab_ensaios,
# usuário somente leitura e AutoLab__ReadOnlyIntent=true. Nunca versione a senha real.
AutoLab__Server=sqlserver
AutoLab__Database=autolab
AutoLab__User=sa
AutoLab__Password=${SQLSERVER_SA_PASSWORD:-LactecDemo2026!}
AutoLab__Encrypt=false
AutoLab__TrustServerCertificate=true
AutoLab__ReadOnlyIntent=false
AutoLab__ApplicationName=portal-api
AutoLab__CommandTimeoutSeconds=15
AutoLab__ConnectTimeoutSeconds=10
AutoLab__MaxPoolSize=10
AutoLab__MaxRowsPerQuery=5000
