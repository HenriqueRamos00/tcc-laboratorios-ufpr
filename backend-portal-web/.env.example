PORT=5125
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

Salesforce__Url=https://login.salesforce.com
Salesforce__TokenPath=/services/oauth2/token
Salesforce__ApiVersion=v60.0
Salesforce__GrantType=client_credentials
Salesforce__ClientId=your-connected-app-client-id
Salesforce__ClientSecret=your-connected-app-client-secret

BackendLab__BaseUrl=http://localhost:8080
BackendLab__TimeoutSeconds=10
BackendLabJwt__Secret=change-this-secret-with-at-least-32-characters
# Identifica quem emite o token interno.
BackendLabJwt__Issuer=tcc-backend-lab
# Identifica o destino previsto do token interno.
BackendLabJwt__Audience=tcc-portal-api-internal
# Tolerância entre relógios dos serviços, em segundos.
BackendLabJwt__ClockSkewSeconds=30
BACKEND_LAB_DOCKER_BASE_URL=http://host.docker.internal:8080
