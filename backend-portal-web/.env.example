PORT=5125
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
Portal__DataSource=backend-lab # ou lactec (Backend Auth)

# Endereço do Spring para o Compose isolado.
# Para dotnet run fora do Docker, use BackendLab__BaseUrl=http://localhost:8080.
BackendLab__BaseUrl=http://host.docker.internal:8080

Salesforce__Url=https://login.salesforce.com
Salesforce__TokenPath=/services/oauth2/token
Salesforce__ApiVersion=v60.0
Salesforce__GrantType=client_credentials
Salesforce__ClientId=your-connected-app-client-id
Salesforce__ClientSecret=your-connected-app-client-secret

# Obrigatórios somente em lactec; dotnet run lê variáveis do processo, não o .env.
# Para Docker use o overlay ../compose.auth.yaml e a configuração .env da raiz.
BackendAuth__BaseUrl=http://localhost:8081
BackendAuth__ServiceCode=portal-web
BackendAuth__ServiceToken=
PortalJwt__Issuer=portal-api
PortalJwt__Audience=portal-web
# Gere um segredo exclusivo: openssl rand -base64 32
PortalJwt__SigningKey=
PortalJwt__ExpirationSeconds=900
