POSTGRES_PORT=5432
POSTGRES_DB=backend_lab
POSTGRES_USER=backend_lab
POSTGRES_PASSWORD=backend_lab
LAB_POSTGRES_VOLUME=tcc-laboratorios-postgres
APP_PORT=8080
# Use 0.0.0.0 se um container separado precisar acessar a API por host.docker.internal.
APP_BIND_ADDRESS=127.0.0.1
PORTAL_INTERNO_DEV_PORT=4201
PORTAL_API_PORT=5125
Portal__DataSource=backend-lab #ou lactec
BACKEND_LAB_BASE_URL=http://backend-lab:8080
JPA_DDL_AUTO=update
JWT_SECRET=change-this-secret-with-at-least-32-characters
JWT_EXPIRATION_SECONDS=3600

# Preencha para criar o administrador no primeiro acesso ao Portal Interno.
AUTH_SEED_ADMIN_NAME=Administrador
AUTH_SEED_ADMIN_EMAIL=admin@example.com
AUTH_SEED_ADMIN_PASSWORD=
AUTH_SEED_TECHNICIAN_NAME=
AUTH_SEED_TECHNICIAN_EMAIL=
AUTH_SEED_TECHNICIAN_PASSWORD=

# Ambiente de build Android e aparelho em modo ADB TCP.
HOST_UID=1000
HOST_GID=1000
ADB_DEVICE=

# Habilita os dados e a conta de demonstração somente no ambiente local.
DEMO_SEED_ENABLED=false
