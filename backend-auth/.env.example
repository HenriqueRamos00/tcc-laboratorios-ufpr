AUTH_PORT=8081
SQLSERVER_PORT=1433
# Senha do SQL Server local, compatível com a política de senhas do SQL Server.
SQLSERVER_SA_PASSWORD=
JPA_DDL_AUTO=update
# URL usada para exibir o link de configuração inicial nos logs.
APP_BASE_URL=http://localhost:8081
ADMIN_TOKEN_EXPIRATION_SECONDS=3600
SERVICE_TOKEN_EXPIRATION_SECONDS=2592000
CLIENT_LOGIN_COOLDOWN_SECONDS=900

# Opcional no Compose isolado; a demonstração completa está em ../compose.auth.yaml.
AUTH_DEMO_SEED_ENABLED=false
# Obrigatório se habilitar o seed: svc_ seguido de 43 caracteres base64url.
BACKEND_AUTH_SERVICE_TOKEN=
