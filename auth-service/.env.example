# SQL Server e banco do auth-service
AUTH_DB_NAME=auth
AUTH_DB_PORT=1433
AUTH_DB_PASSWORD=ChangeMe_StrongPassword123!

# Portas publicadas
AUTH_PORT=9000
AUTH_FRONTEND_PORT=4202

# Emissor OAuth2/OIDC
AUTH_ISSUER=http://localhost:9000

# Chave de assinatura PKCS12 gerada por scripts/generate-signing-keystore.sh
AUTH_KEY_STORE=file:/secrets/auth-signing.p12
AUTH_KEY_STORE_PASSWORD=change-me

# Cliente OAuth2 do portal-web
AUTH_PORTAL_CLIENT_SECRET=change-this-client-secret-with-at-least-32-chars
AUTH_PORTAL_REDIRECT_URI=http://localhost:5125/signin-oidc
AUTH_PORTAL_LOGOUT_REDIRECT_URI=http://localhost:5125/signout-callback-oidc

# Token de uso único para criar o primeiro administrador.
# Gere com: openssl rand -base64 48
AUTH_SETUP_TOKEN=

# Sessão administrativa
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TIMEOUT=15m
