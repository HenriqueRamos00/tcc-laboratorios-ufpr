<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerPanel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lactec_nav"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="12dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/navHome"
            style="@style/Widget.Lactec.PortalDrawerItem"
            android:drawableStart="@drawable/ic_nav_home"
            android:text="@string/nav_home" />

        <TextView
            android:id="@+id/navQuotes"
            style="@style/Widget.Lactec.PortalDrawerItem"
            android:background="@drawable/bg_portal_nav_item"
            android:drawableStart="@drawable/ic_nav_quotes"
            android:text="@string/quotes_title" />

        <TextView
            android:id="@+id/navReports"
            style="@style/Widget.Lactec.PortalDrawerItem"
            android:drawableStart="@drawable/ic_nav_reports"
            android:text="@string/nav_reports" />

        <TextView
            android:id="@+id/navEquipment"
            style="@style/Widget.Lactec.PortalDrawerItem"
            android:drawableStart="@drawable/ic_nav_equipment"
            android:text="@string/nav_equipment" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/navProfile"
            style="@style/Widget.Lactec.PortalDrawerItem"
            android:drawableStart="@drawable/ic_nav_profile"
            android:text="@string/nav_profile" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:background="#33FFFFFF" />

        <TextView
            android:id="@+id/logoutButton"
            style="@style/Widget.Lactec.PortalDrawerItem"
            android:drawableStart="@drawable/ic_nav_logout"
            android:text="@string/logout" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
