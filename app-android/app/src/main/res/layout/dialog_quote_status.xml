<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/quoteStatusScroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:id="@+id/loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp"
            tools:visibility="gone">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminateTint="@color/lactec_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="polite"
                android:fontFamily="@font/inter"
                android:gravity="center"
                android:text="@string/quote_status_loading"
                android:textColor="@color/lactec_muted"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/stateMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:padding="16dp"
            android:textColor="@color/lactec_muted"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="Não foi possível carregar o status. Tente novamente."
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/retryButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/quote_status_retry"
            android:visibility="gone"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/statusContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/proposalCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/instrument_sans"
                android:textColor="@color/lactec_ink"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Proposta: 12345" />

            <TextView
                android:id="@+id/phaseTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/instrument_sans"
                android:textColor="@color/lactec_ink"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Status da Proposta" />

            <TextView
                android:id="@+id/currentStatus"
                android:accessibilityLiveRegion="polite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/inter"
                android:gravity="center"
                android:textColor="@color/lactec_muted"
                android:textSize="14sp"
                tools:text="Status atual: Em negociação" />

            <LinearLayout
                android:id="@+id/progressSteps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <include
                    android:id="@+id/stepOne"
                    layout="@layout/item_quote_status_step"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/stepTwo"
                    layout="@layout/item_quote_status_step"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/stepThree"
                    layout="@layout/item_quote_status_step"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/noticeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/noticeTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/instrument_sans"
                    android:textColor="@color/lactec_ink"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Estamos em busca da melhor solução para seu negócio" />

                <TextView
                    android:id="@+id/noticeMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/inter"
                    android:textColor="@color/lactec_muted"
                    android:textSize="14sp"
                    tools:text="Nossos profissionais estão validando qual é o laboratório capaz de solucionar e trazer resultados para cada uma das análises requisitadas. Em breve seu orçamento ficará disponível por meio desta plataforma!" />
            </LinearLayout>

            <TextView
                android:id="@+id/terminalMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/inter"
                android:textColor="@color/lactec_muted"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="Esta proposta foi encerrada. Não há etapas em andamento."
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/externalContactGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/instrument_sans"
                    android:text="@string/quote_status_external_contact"
                    android:textColor="@color/lactec_ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/externalContactName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/inter"
                    android:textColor="@color/lactec_muted"
                    android:textSize="14sp"
                    tools:text="Nome do contato" />

                <TextView
                    android:id="@+id/externalContactEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:textColor="@color/lactec_muted"
                    android:textSize="14sp"
                    tools:text="contato@example.com" />

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
