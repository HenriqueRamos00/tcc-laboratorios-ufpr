<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/decisionMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/instrument_sans"
            android:textColor="@color/lactec_ink"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:accessibilityTraversalAfter="@id/decisionMessage"
            android:id="@+id/reasonLayout"
            style="@style/Widget.Lactec.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/quote_rejection_reason"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/reason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textCapSentences|textMultiLine"
                android:minHeight="120dp"
                android:minLines="3" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/simulationNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/inter"
            android:text="@string/quote_simulation_notice"
            android:textColor="@color/lactec_muted"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/confirmDecision"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="52dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/lactec_primary"
            android:text="@string/quote_confirm_accept_action"
            android:textColor="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancelDecision"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="52dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/quote_action_neutral"
            android:text="@string/quote_cancel"
            android:textColor="@color/lactec_ink" />
    </LinearLayout>
</ScrollView>
