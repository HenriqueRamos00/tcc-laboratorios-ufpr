<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/detailsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lactec_surface"
    android:orientation="vertical"
    tools:context=".controller.QuoteDetailsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/lactec_nav"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/quote_back"
            android:padding="12dp"
            android:scaleType="centerInside"
            app:srcCompat="@drawable/ic_quote_back"
            app:tint="@color/white" />

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@null"
            android:src="@drawable/lactec_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/instrument_sans"
            android:text="@string/lactec"
            android:textColor="@color/white"
            android:textSize="21sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/detailsScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/instrument_sans"
                    android:text="@string/quote_details_title"
                    android:textColor="@color/lactec_ink"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/loading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="20dp"
                    android:indeterminateTint="@color/lactec_primary"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/stateMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:fontFamily="@font/inter"
                    android:gravity="center"
                    android:padding="16dp"
                    android:textColor="@color/lactec_muted"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:text="Não foi possível carregar o orçamento."
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/retryButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/quote_status_retry"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <LinearLayout
                    android:id="@+id/detailsContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_quote_card"
                    android:elevation="1dp"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/proposalName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/instrument_sans"
                        android:textColor="@color/lactec_nav"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="Detalhes do Orçamento: Análise de óleo" />

                    <TextView
                        android:id="@+id/proposalCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/inter"
                        android:textColor="@color/lactec_muted"
                        android:textSize="14sp"
                        tools:text="Proposta: EAQ_2026_45484_V_1" />

                    <TextView
                        android:id="@+id/clientName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/inter"
                        android:textColor="@color/lactec_ink"
                        android:textSize="16sp"
                        tools:text="Cliente: Empresa Exemplo" />

                    <TextView
                        android:id="@+id/description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/inter"
                        android:textColor="@color/lactec_muted"
                        android:textSize="14sp"
                        tools:text="Descrição dos serviços solicitados." />

                    <TextView
                        android:id="@+id/totalPrice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/instrument_sans"
                        android:textColor="@color/lactec_ink"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        tools:text="Total: R$ 3.450,00" />

                    <TextView
                        android:id="@+id/serverStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/inter"
                        android:textColor="@color/lactec_muted"
                        android:textSize="14sp"
                        tools:text="Status: Pendente de Aceite" />


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/instrument_sans"
                            android:text="@string/quote_document_heading"
                            android:textColor="@color/lactec_ink"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/downloadPdf"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:minWidth="48dp"
                            android:text="@string/quote_download_pdf" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/pdfLoading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="16dp"
                        android:indeterminateTint="@color/lactec_primary"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/pdfMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite"
                        android:fontFamily="@font/inter"
                        android:gravity="center"
                        android:padding="14dp"
                        android:textColor="@color/lactec_muted"
                        android:textSize="14sp"
                        android:visibility="gone"
                        tools:text="Documento não encontrado."
                        tools:visibility="visible" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pdfRetryButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_gravity="center_horizontal"
                        android:text="@string/quote_status_retry"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/pdfPage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/quote_pdf_accessibility_default"
                        android:scaleType="fitCenter"
                        android:visibility="gone"
                        tools:src="@drawable/lactec_logo"
                        tools:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/pdfControls"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/previousPage"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:minWidth="48dp"
                            android:text="@string/quote_pdf_previous" />

                        <TextView
                            android:id="@+id/pageCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="12dp"
                            android:fontFamily="@font/inter"
                            android:textColor="@color/lactec_muted"
                            android:textSize="14sp"
                            tools:text="Página 1 de 3" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/nextPage"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:minWidth="48dp"
                            android:text="@string/quote_pdf_next" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/rejectQuote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:minHeight="52dp"
                        android:layout_marginTop="18dp"
                        android:backgroundTint="@color/quote_action_reject"
                        android:text="@string/quote_reject"
                        android:textColor="@color/white"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/acceptQuote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:minHeight="52dp"
                        android:layout_marginTop="10dp"
                        android:backgroundTint="@color/quote_action_accept"
                        android:text="@string/quote_accept"
                        android:textColor="@color/white"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
