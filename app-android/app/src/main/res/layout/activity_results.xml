<?xml version="1.0" encoding="utf-8"?>
<!-- Tela "Relatórios" do menu. Duas abas, como no portal web: todos os laudos publicados,
     ou os orçamentos que já têm laudo (que abrem a tela de relatórios do orçamento). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/resultsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lactec_surface"
    android:orientation="vertical"
    tools:context=".controller.ResultsActivity">

    <include layout="@layout/layout_portal_header" />

    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/portalDrawer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Cabeçalho (results_list_header), laudos (item_report) e rodapé rolam juntos. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/resultsScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp"
            android:saveEnabled="false"
            tools:listitem="@layout/item_report" />

        <include
            layout="@layout/layout_portal_drawer"
            android:layout_width="200dp"
            android:layout_height="match_parent"
            android:layout_gravity="right" />
    </androidx.drawerlayout.widget.DrawerLayout>
</LinearLayout>
