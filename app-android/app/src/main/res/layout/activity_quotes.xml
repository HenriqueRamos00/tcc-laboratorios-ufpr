<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quotesRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lactec_surface"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/lactec_nav"
        android:fontFamily="@font/instrument_sans"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        android:text="@string/quotes_title"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fontFamily="@font/inter"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/quotes_empty"
        android:textColor="@color/lactec_muted"
        android:textSize="14sp" />
</LinearLayout>
