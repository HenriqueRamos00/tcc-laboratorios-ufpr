<resources>
    <style name="Base.Theme.Labmobile" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/lactec_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorError">@color/lactec_danger</item>
        <item name="android:colorAccent">@color/lactec_primary</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:navigationBarColor">@color/lactec_paper</item>
        <item name="android:statusBarColor">@color/lactec_nav</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="Theme.Labmobile" parent="Base.Theme.Labmobile" />
    <style name="Widget.Lactec.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/lactec_primary</item>
        <item name="boxStrokeErrorColor">@color/lactec_danger</item>
        <item name="hintTextColor">@color/lactec_ink</item>
        <item name="startIconTint">@color/lactec_muted</item>
        <item name="endIconTint">@color/lactec_muted</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>
    <style name="Widget.Lactec.PortalDrawerItem" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_portal_nav_item</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:drawableTint">@color/white</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="Widget.Lactec.DemoReportField" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">@color/lactec_muted</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
