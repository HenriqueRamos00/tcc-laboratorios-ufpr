# Endereco do aparelho Android em modo TCP, no formato ip:porta.
# Descubra com: docker compose exec app-android adb devices
# O container conecta nele automaticamente no `docker compose up`.
ADB_DEVICE=192.168.100.50:5555

# Porta local da API encaminhada ao aparelho (0 desativa adb reverse).
ADB_REVERSE_PORT=5125
# Opcional: raiz da API para o APK, sem /api. Vazio usa http://127.0.0.1:5125/ em debug.
ANDROID_PORTAL_API_URL=
