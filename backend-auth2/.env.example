# Copie para .env e preencha. O .env nao entra no git.
ORACLE_PASSWORD=troque-esta-senha-do-banco

# Dono do esquema. E ele que roda a migracao do Flyway e o unico com permissao de criar
# tabela. A aplicacao nunca usa esta credencial em tempo de execucao.
AUTH_SCHEMA_OWNER_USERNAME=auth_owner
AUTH_SCHEMA_OWNER_PASSWORD=troque-esta-senha-do-dono-do-esquema

# Usuario da aplicacao. Sem comando de definicao, sem cota de espaco, le e grava por papel.
AUTH_DATASOURCE_URL=jdbc:oracle:thin:@//oracle:1521/FREEPDB1
AUTH_DATASOURCE_USERNAME=auth_app
AUTH_DATASOURCE_PASSWORD=troque-esta-senha-da-aplicacao

# Segredo de instalacao, usado uma vez para cadastrar o primeiro administrador. Depois do
# primeiro, a rota responde como inexistente mesmo com o segredo correto.
AUTH_SETUP_SECRET=troque-este-segredo-de-instalacao

# Servidor de e-mail. Sem ele a aplicacao nao sobe, e isso e de proposito: cadastro sem
# confirmacao e conta que ninguem usa. Para exercitar localmente, suba um mailpit e aponte
# AUTH_MAIL_HOST para ele.
AUTH_MAIL_HOST=smtp.exemplo
AUTH_MAIL_PORT=587
AUTH_MAIL_USERNAME=troque-este-usuario-do-servidor-de-email
AUTH_MAIL_PASSWORD=troque-esta-senha-do-servidor-de-email
AUTH_MAIL_SENDER=nao-responda@lactec.exemplo

# Endereco das telas que recebem quem clica no link. O marcador {token} e obrigatorio nos
# dois, e a aplicacao recusa a subida sem ele: mensagem com link sem token sai bonita e nao
# confirma nada.
AUTH_CONFIRMATION_LINK=https://portal.exemplo/confirmar?token={token}
AUTH_RECOVERY_LINK=https://portal.exemplo/nova-senha?token={token}
