<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- O parent decide a versao de Tomcat, de Jackson, de Spring Framework, de Spring
             Security e de Hibernate, entao subir uma versao de correcao aqui e a forma de
             fechar aviso de seguranca de todos eles de uma vez. Da 4.1.1 para a 4.1.2:
             Tomcat 11.0.24 para 11.0.27, Jackson 3.1.5 para 3.1.7 e 2.21.5 para 2.21.7. Dos
             avisos de Tomcat, o unico alcancavel neste desenho e o do cabecalho
             transfer-encoding em HTTP/1.0 atras de proxy reverso, e este servico assume
             borda na frente; os de Jackson sao de consumo de tempo em numero decimal e nao
             ha campo decimal em corpo de entrada nenhum. Ou seja, nenhum e exploravel aqui
             hoje, e e justamente por isso que a atualizacao e barata. -->
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>br.ufpr.tcc</groupId>
    <artifactId>backend-auth2</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>backend-auth2</name>
    <description>Autenticacao e autorizacao compartilhada entre as aplicacoes do Lactec</description>

    <properties>
        <java.version>21</java.version>
        <!-- Sem isto cada construcao gera um jar diferente do mesmo codigo, e nao da para
             provar que a imagem publicada corresponde ao fonte: medido, duas construcoes
             seguidas da mesma arvore deram resumos diferentes, com a hora da maquina gravada
             no MANIFEST. O Maven 3.9 nao liga reprodutibilidade por padrao, e o repackage do
             Boot le esta propriedade. A data acompanha a entrega. -->
        <project.build.outputTimestamp>2026-10-28T00:00:00Z</project.build.outputTimestamp>
        <springdoc.version>3.2.0</springdoc.version>
        <hypersistence-tsid.version>2.1.4</hypersistence-tsid.version>
        <bouncycastle.version>1.86</bouncycastle.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Adaptador de servidor de e-mail. O starter traz a auto configuracao que monta
             o JavaMailSender a partir de spring.mail.*, mais jakarta.mail-api e angus-mail.
             Licenca conferida no POM publicado, nao na pagina de marketing: o starter e o
             modulo spring-boot-mail declaram Apache-2.0; o jakarta.mail-api declara EPL-2.0,
             GPL2 com excecao de classpath e EDL-1.0; e o angus-mail nao tem elemento
             licenses proprio e herda as mesmas tres do pai, do mesmo jeito que o caso do
             hypersistence-utils mostrou que isso se confere. O que a plataforma nao resolve:
             falar SMTP. Sem isto nao existe cliente de protocolo nenhum no processo. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- O modulo de auto configuracao, nao a biblioteca. No Boot 4 a auto
             configuracao do Flyway saiu do spring-boot-autoconfigure e virou artefato
             proprio, e ele ja traz o flyway-core. Medido: nenhum jar do Boot no cache
             contem FlywayAutoConfiguration, entao com flyway-core sozinho a propriedade
             spring.flyway.enabled nao liga nada e a migracao nunca roda. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-oracle</artifactId>
        </dependency>
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc17</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>io.hypersistence</groupId>
            <artifactId>hypersistence-tsid</artifactId>
            <version>${hypersistence-tsid.version}</version>
        </dependency>

        <!-- Exigida pelo Argon2PasswordEncoder do Spring Security, que declara na
             documentacao que a implementacao atual precisa do BouncyCastle. Licenca
             declarada no POM publicado como Bouncy Castle Licence, que e o texto do MIT
             adaptado, e a serie corrente tem manutencao recente.

             Escopo de execucao, e nao de compilacao, pelo mesmo motivo do driver do Oracle:
             nenhum arquivo do modulo importa org.bouncycastle, a ligacao e feita dentro do
             Spring Security, e em compilacao a biblioteca ficaria disponivel para alguem usar
             primitiva criptografica direto, fora do PasswordHashing e fora de revisao. -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>${bouncycastle.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- spring-boot-starter-security-test e testcontainers-junit-jupiter sairam daqui:
             nenhum arquivo da suite importa org.springframework.security.test nem usa as
             anotacoes @Testcontainers e @Container, porque o ciclo de vida do contentor vem
             do @ServiceConnection do Boot. Dependencia declarada e nao usada e peso na
             resolucao e na camada de dependencia da imagem, e some da revisao. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-oracle-free</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>backend-auth2</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>-parameters</arg>
                        <arg>-Xlint:all</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
