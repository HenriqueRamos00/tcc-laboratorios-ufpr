    "components": {
        "schemas": {
            "UpdateClientRequest": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "maxLength": 150,
                        "minLength": 0
                    },
                    "active": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "active",
                    "name"
                ]
            },
            "AccountSummary": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "role": {
                        "type": "string"
                    },
                    "active": {
                        "type": "boolean"
                    },
                    "serviceId": {
                        "type": "string"
                    },
                    "emailConfirmed": {
                        "type": "boolean"
                    }
                }
            },
            "UpdateApplicationRequest": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "maxLength": 150,
                        "minLength": 0
                    },
                    "code": {
                        "type": "string",
                        "maxLength": 80,
                        "minLength": 0,
                        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                    },
                    "active": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "active",
                    "code",
                    "name"
                ]
            },
            "RegisteredApplicationView": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "code": {
                        "type": "string"
                    },
                    "active": {
                        "type": "boolean"
                    }
                }
            },
            "CompanyRequest": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "maxLength": 150,
                        "minLength": 0
                    },
                    "cnpj": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[0-9]{14}$"
                    }
                },
                "required": [
                    "cnpj",
                    "name"
                ]
            },
            "CompanyView": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "cnpj": {
                        "type": "string"
                    },
                    "serviceId": {
                        "type": "string"
                    }
                }
            },
            "UpdateAdministratorRequest": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "maxLength": 150,
                        "minLength": 0
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "maxLength": 254,
                        "minLength": 0
                    },
                    "active": {
                        "type": "boolean"
                    },
                    "password": {
                        "type": "string",
                        "format": "password",
                        "description": "Senha, preservando espacos: o servidor nao corta espaco nas pontas,\n nao muda a caixa e nao remove acentuacao, porque cada uma dessas trocas\n mudaria a credencial em silencio. O minimo de oito, mais maiuscula,\n minuscula e digito, e cobrado pelo caso de uso e nao por anotacao.",
